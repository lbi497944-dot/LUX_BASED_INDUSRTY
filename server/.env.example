# Veloura Lighting - Server Environment Variables Configuration Template
# NOTE: Never commit actual secrets or production credentials to source control.

NODE_ENV=development
PORT=5000

# MongoDB Database Connection URI (Atlas in production, local/Atlas in development)
MONGODB_URI=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRE=24h

# Frontend Client Application URL (supports comma-separated list of allowed origins)
CLIENT_URL=http://localhost:5173

# SMTP Email Notification Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Cloudinary Media Storage (optional, defaults to local disk if unconfigured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=veloura_lighting

# Initial Admin Credentials (used only during manual initial database setup)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=