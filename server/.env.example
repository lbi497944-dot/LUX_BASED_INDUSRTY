# Veloura Lighting - Server Environment Variables

NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/veloura_lighting

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=24h

# Client Application URL
CLIENT_URL=http://localhost:5173

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=veloura_lighting

# Initial Admin Seeder Credentials
INITIAL_ADMIN_USERNAME=Veloura Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_password