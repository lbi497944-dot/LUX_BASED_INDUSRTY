# Veloura Lighting — Server Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local MongoDB or Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/veloura_lighting

# JWT Authentication
JWT_SECRET=veloura_luxury_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRE=24h

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration (Optional for development; falls back to local disk upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=veloura_lighting

# Initial Admin Seeder Credentials
INITIAL_ADMIN_USERNAME=Veloura Admin
INITIAL_ADMIN_EMAIL=admin@veloura-lighting.com
INITIAL_ADMIN_PASSWORD=VelouraAdmin2026!
